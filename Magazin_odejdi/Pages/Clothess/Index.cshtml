@page
@model Magazin_odejdi.Pages.Clothess.IndexModel
@{
    ViewData["Title"] = "Список товаров";
}

<div class="container mt-4">

    <!-- Заголовок и кнопка добавления книги -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Список товаров</h2>
        <a asp-page="Create" class="btn btn-success">
            Добавить новый товар
        </a>
    </div>

    <!-- Плитки книг -->
    <div class="row g-4">
        @foreach (var clothes in Model.Clothes)
        {
            <!-- Каждая карточка книги в колонке -->
            <div class="col-sm-6 col-md-4 col-lg-3">

                <!-- Карточка книги с тенью -->
                <div class="card h-100 shadow-sm" id="book-@clothes.Id">
                    <div class="card-body">

                        <!-- Заголовок книги с иконкой и обрезкой текста -->
                        <h5 class="card-title text-truncate">
                            @clothes.Naimenovanie
                        </h5>

                        <!-- Автор -->
                        <p class="card-text text-muted mb-1">
                            Категория: @clothes.Category
                        </p>

                        <!-- Год публикации -->
                        <p class="card-text mb-1">
                            Размер: <span class="badge bg-secondary">@clothes.Size</span>
                        </p>

                        <!-- Количество экземпляров -->
                        <p class="card-text mb-2">
                            Цвет: <span class="badge bg-info">@clothes.Color</span>
                        </p>

                        <p class="card-text mb-2">
                            Материал: <span class="badge bg-info">@clothes.Material</span>
                        </p>

                        <p class="card-text mb-2">
                            Цена: <span class="badge bg-info">@clothes.Price</span>
                        </p>

                        <!-- Кнопки действий -->
                        <div class="d-flex justify-content-between">
                            <a asp-page="Details" asp-route-id="@clothes.Id" class="btn btn-sm btn-info">
                                Открыть
                            </a>
                            <a asp-page="Edit" asp-route-id="@clothes.Id" class="btn btn-sm btn-warning">
                                Изменить
                            </a>
                            <a asp-page="Delete" asp-route-id="@clothes.Id" class="btn btn-sm btn-danger">
                                Удалить
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        }
    </div>

</div>
