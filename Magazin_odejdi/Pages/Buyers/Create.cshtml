@page
@model Magazin_odejdi.Pages.Buyers.CreateModel
@{
}

<h1 class="mb-4">Добавить клиента</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Buyer.FIO" class="form-label">ФИО</label>
                        <input asp-for="Buyer.FIO" class="form-control" />
                        <span asp-validation-for="Buyer.FIO" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Buyer.Telefon" class="form-label">Телефон</label>
                        <input asp-for="Buyer.Telefon" class="form-control" />
                        <span asp-validation-for="Buyer.Telefon" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Buyer.Email" class="form-label">Электронная почта</label>
                        <input asp-for="Buyer.Email" class="form-control" />
                        <span asp-validation-for="Buyer.Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Buyer.Data_BirthDay" class="form-label">Дата рождения</label>
                        <input asp-for="Buyer.Data_BirthDay" type="date" class="form-control" />
                        <span asp-validation-for="Buyer.Data_BirthDay" class="text-danger"></span>
                        
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            Сохранить
                        </button>

                        <a asp-page="Index" class="btn btn-secondary">
                            Назад
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}