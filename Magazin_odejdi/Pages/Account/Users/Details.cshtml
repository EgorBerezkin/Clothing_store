@page
@model Magazin_odejdi.Pages.Account.Users.DetailsModel
@{
}

<div class="container mt-4">

    <h2>User Details</h2>

    <div class="card">

        <div class="card-body">
            @if (Model.User.Avatar != null)
            {
                <div class="mb-3">
                    <img style="max-width:150px;"
                         src="data:image/png;base64,@Convert.ToBase64String(Model.User.Avatar)" />
                </div>
            }
            <p><b>Email:</b> @Model.User.Email</p>
            <p><b>Role:</b> @Model.User.Role</p>

        </div>

    </div>

    <br>

    <a asp-page="Edit" asp-route-id="@Model.User.Id"
       class="btn btn-warning">
        Изменить
    </a>

    <a asp-page="Index" class="btn btn-secondary">
        Отмена
    </a>

</div>