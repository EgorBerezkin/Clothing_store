@page
@model Magazin_odejdi.Pages.Buyers.DeleteModel
@{
}

<h1>Удалить покупателя</h1>

<h3>Вы уверены?</h3>

<div>
    <p><strong>@Model.Buyer.FIO</strong></p>
    <p>Телефон: @Model.Buyer.Telefon</p>
    <p>Email: @Model.Buyer.Email</p>
    <p>Дата рождения: @Model.Buyer.Data_BirthDay</p>
</div>

<form method="post">
    <input type="hidden" asp-for="Buyer.FIO" />
    <button type="submit">Удалить</button>
</form>

<a asp-page="Index">Отмена</a>