@page
@model Magazin_odejdi.Pages.Clothess.DetailsModel
@{
    ViewData["Title"] = "Информация о товаре";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Информация о товаре</h4>
                </div>

                <div class="card-body">

                    <h5 class="card-title mb-3">
                        @Model.Clothes.Naimenovanie
                    </h5>

                    <ul class="list-group list-group-flush mb-3">

                        <li class="list-group-item">
                            <strong>Категория:</strong>
                            <span class="text-muted">@Model.Clothes.Category</span>
                        </li>

                        <li class="list-group-item">
                            <strong>Размер:</strong>
                            <span class="badge bg-secondary">
                                @Model.Clothes.Size
                            </span>
                        </li>

                        <li class="list-group-item">
                            <strong>Цвет:</strong>
                            <span class="text-muted">@Model.Clothes.Color</span>
                        </li>

                        <li class="list-group-item">
                            <strong>Метриал:</strong>
                            <span class="text-muted">@Model.Clothes.Material</span>
                        </li>

                        <li class="list-group-item">
                            <strong>Цена:</strong>
                            <span class="badge bg-info">
                                @Model.Clothes.Price
                            </span>
                        </li>

                    </ul>

                    <div class="d-flex justify-content-between">

                        <a asp-page="Index" class="btn btn-secondary">
                            Назад
                        </a>

                        <a asp-page="Edit"
                           asp-route-id="@Model.Clothes.Id"
                           class="btn btn-warning">
                            Редактировать
                        </a>

                    </div>

                </div>

            </div>

        </div>
    </div>

</div>
